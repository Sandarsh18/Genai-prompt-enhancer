# GenAI Provider Configuration
# Set to 'gemini' or 'openai'
GENAI_PROVIDER=gemini

# GenAI Model (e.g., gemini-1.5-flash, gpt-3.5-turbo, gpt-4)
GENAI_MODEL=gemini-2.5-flash

# Gemini Configuration
GENAI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# OpenAI Configuration (if using OpenAI)
# GENAI_API_BASE_URL=https://api.openai.com/v1/chat/completions

# API Key (REQUIRED - get from https://aistudio.google.com/apikey for Gemini)
GENAI_API_KEY=your_api_key_here

# Timeout for GenAI requests (seconds)
GENAI_TIMEOUT=12
