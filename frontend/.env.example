# Frontend should call the gateway using the full local URL during local development.
# The gateway endpoints (e.g. /rewrite, /email) accept POST only — avoid GET or browser address bar checks.
VITE_GATEWAY_URL=http://localhost:8088
# If your gateway exposes a rewrite prefix, include it here (e.g. /rewrite). Leave empty if not used.
VITE_GATEWAY_REWRITE_PATH=/rewrite

# Optional convenience: full rewrite URL (frontend can use this directly)
# Example usage: fetch(import.meta.env.VITE_GATEWAY_FULL_REWRITE_URL, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) })
VITE_GATEWAY_FULL_REWRITE_URL=http://localhost:8088/rewrite

# Direct rewrite service (bypass gateway) for debugging (frontend fallback target)
VITE_DIRECT_REWRITE_URL=http://localhost:8000/rewrite

# When true the frontend will try DIRECT_REWRITE_URL if the gateway returns 5xx
VITE_ENABLE_FALLBACK=true

# Usage notes:
# - To test gateway: curl -v -X POST "$VITE_GATEWAY_FULL_REWRITE_URL" -H "Content-Type: application/json" -d '{"text":"test"}'
# - To bypass gateway: curl -v -X POST "$VITE_DIRECT_REWRITE_URL" -H "Content-Type: application/json" -d '{"text":"test"}'
#   : `${import.meta.env.VITE_GATEWAY_URL}${import.meta.env.VITE_GATEWAY_REWRITE_PATH}`;
# fetch(target, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) })

# Usage notes:
# - To test gateway: curl -v -X POST "$VITE_GATEWAY_FULL_REWRITE_URL" -H "Content-Type: application/json" -d '{"text":"test"}'
# - To bypass gateway: curl -v -X POST "$VITE_DIRECT_REWRITE_URL" -H "Content-Type: application/json" -d '{"text":"test"}'
